+fn state_db_pruning_mode(state_pruning: &str) -> &'static [u8] {
+    if state_pruning.starts_with("archive-canonical") {
+        b"archive_canonical"
+    } else if state_pruning.starts_with("archive") {
+        b"archive"
+    } else {
+        b"constrained"
+    }
+}
+
+fn collect_paritydb_full_paths(path: &Path, result: &mut Vec<PathBuf>) -> std::io::Result<()> {
+    for entry in std::fs::read_dir(path)? {
+        let entry = entry?;
+        let child = entry.path();
+        if !child.is_dir() {
+            continue;
+        }
+        let is_full_database = child.file_name().and_then(|name| name.to_str()) == Some("full")
+            && child
+                .parent()
+                .and_then(Path::file_name)
+                .and_then(|name| name.to_str())
+                == Some("paritydb")
+            && child.join("metadata").is_file();
+        if is_full_database {
+            result.push(child);
+        } else {
+            collect_paritydb_full_paths(&child, result)?;
+        }
+    }
+    Ok(())
+}
+
+pub fn ensure_paritydb_state_metadata(
+    data_path: &str,
+    state_pruning: &str,
+) -> Result<(), anyhow::Error> {
+    let mut database_paths = Vec::new();
+    collect_paritydb_full_paths(Path::new(data_path), &mut database_paths)?;
+    for path in database_paths {
+        let metadata = Options::load_metadata(&path)?
+            .ok_or_else(|| anyhow!("ParityDB metadata is missing at {}", path.display()))?;
+        let mut options = Options::with_columns(&path, metadata.columns.len() as u8);
+        options.columns = metadata.columns;
+        let database = Db::open(&options)?;
+        let mode = state_db_pruning_mode(state_pruning).to_vec();
+        if database.get(2, b"mode")?.is_none() {
+            database.commit([(2, b"mode".as_slice(), Some(mode.clone()))])?;
+            info!(
+                "Recorded missing StateDB pruning mode {} in {}",
+                String::from_utf8_lossy(&mode),
+                path.display()
+            );
+        }
+        drop(database);
+
+        // Reopening replays and flushes a newly committed ParityDB log before the directory is
+        // archived. Without this, a very large state-sync database can lose the final metadata
+        // write when the short-lived repair handle is dropped.
+        let database = Db::open(&options)?;
+        if database.get(2, b"mode")? != Some(mode) {
+            return Err(anyhow!(
+                "StateDB pruning mode was not persisted in {}",
+                path.display()
+            ));
+        }
+    }
+    Ok(())
+}
+
+async fn ensure_paritydb_state_metadata_after_shutdown(
+    data_path: &str,
+    state_pruning: &str,
+) -> Result<(), anyhow::Error> {
+    let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(60);
+    loop {
+        match ensure_paritydb_state_metadata(data_path, state_pruning) {
+            Ok(()) => return Ok(()),
+            Err(error) if tokio::time::Instant::now() < deadline => {
+                debug!("Waiting for the stopped node to release ParityDB: {error}");
+                tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+            }
+            Err(error) => return Err(error),
+        }
+    }
+}
