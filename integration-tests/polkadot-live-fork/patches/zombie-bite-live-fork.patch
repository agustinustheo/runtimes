+fn paritydb_fingerprint(path: &Path) -> Result<(u64, u128), std::io::Error> {
+    fn visit(path: &Path, total_bytes: &mut u64, latest_write: &mut u128) -> std::io::Result<()> {
+        for entry in fs::read_dir(path)? {
+            let entry = entry?;
+            let metadata = entry.metadata()?;
+            if metadata.is_dir() {
+                visit(&entry.path(), total_bytes, latest_write)?;
+            } else {
+                *total_bytes = total_bytes.saturating_add(metadata.len());
+                if let Ok(modified) = metadata.modified() {
+                    if let Ok(elapsed) = modified.duration_since(std::time::UNIX_EPOCH) {
+                        *latest_write = (*latest_write).max(elapsed.as_nanos());
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+
+    let mut total_bytes = 0;
+    let mut latest_write = 0;
+    visit(path, &mut total_bytes, &mut latest_write)?;
+    Ok((total_bytes, latest_write))
+}
+
+fn paritydb_has_stale_indexes(path: &Path) -> Result<bool, std::io::Error> {
+    let mut indexes_per_column = BTreeMap::<String, usize>::new();
+    for entry in fs::read_dir(path)? {
+        let entry = entry?;
+        let name = entry.file_name();
+        let Some(name) = name.to_str() else { continue };
+        let Some(index) = name.strip_prefix("index_") else {
+            continue;
+        };
+        let Some((column, _bits)) = index.split_once('_') else {
+            continue;
+        };
+        *indexes_per_column.entry(column.to_string()).or_default() += 1;
+    }
+    Ok(indexes_per_column.values().any(|count| *count > 1))
+}
+
+async fn wait_for_paritydb_quiescent(data_path: &Path, timeout: Duration) -> Result<(), ()> {
+    let quiet_for = std::env::var("ZOMBIE_BITE_DB_QUIET_SECS")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .map(Duration::from_secs)
+        .unwrap_or_else(|| Duration::from_secs(30));
+    let started = tokio::time::Instant::now();
+    let mut unchanged_since = None;
+    let mut previous = None;
+
+    while started.elapsed() < timeout {
+        let full_path = find_paritydb_full_path(data_path).map_err(|error| {
+            error!(
+                "❌ Could not inspect ParityDB under {}: {error}",
+                data_path.display()
+            );
+        })?;
+        let fingerprint = paritydb_fingerprint(&full_path).map_err(|error| {
+            error!("❌ Could not fingerprint {}: {error}", full_path.display());
+        })?;
+        let has_stale_indexes = paritydb_has_stale_indexes(&full_path).map_err(|error| {
+            error!(
+                "❌ Could not inspect indexes in {}: {error}",
+                full_path.display()
+            );
+        })?;
+
+        if previous == Some(fingerprint) {
+            let quiet_since = unchanged_since.get_or_insert_with(tokio::time::Instant::now);
+            if quiet_since.elapsed() >= quiet_for {
+                info!(
+                    "✅ ParityDB is quiescent at {} ({} bytes unchanged for {}s, recoverable reindex pending: {})",
+                    full_path.display(),
+                    fingerprint.0,
+                    quiet_for.as_secs(),
+                    has_stale_indexes,
+                );
+                return Ok(());
+            }
+        } else {
+            unchanged_since = None;
+            previous = Some(fingerprint);
+        }
+        if has_stale_indexes {
+            info!(
+                "ParityDB has a recoverable background reindex at {}; waiting for writes to settle",
+                full_path.display()
+            );
+        }
+        tokio::time::sleep(Duration::from_secs(5)).await;
+    }
+
+    error!(
+        "❌ ParityDB did not become quiescent within {}s under {}",
+        timeout.as_secs(),
+        data_path.display()
+    );
+    Err(())
+}
+
+fn find_paritydb_full_path(path: &Path) -> Result<PathBuf, std::io::Error> {
+    for entry in fs::read_dir(path)? {
+        let entry = entry?;
+        let child = entry.path();
+        if !child.is_dir() {
+            continue;
+        }
+        if child.file_name().and_then(|name| name.to_str()) == Some("full")
+            && child
+                .parent()
+                .and_then(Path::file_name)
+                .and_then(|name| name.to_str())
+                == Some("paritydb")
+            && child.join("metadata").is_file()
+        {
+            return Ok(child);
+        }
+        if let Ok(found) = find_paritydb_full_path(&child) {
+            return Ok(found);
+        }
+    }
+    Err(std::io::Error::new(
+        std::io::ErrorKind::NotFound,
+        format!("no ParityDB full database below {}", path.display()),
+    ))
+}
