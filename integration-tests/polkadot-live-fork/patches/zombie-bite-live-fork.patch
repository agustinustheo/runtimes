+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn test_directory(name: &str) -> PathBuf {
+        std::env::temp_dir().join(format!(
+            "zombie-bite-{name}-{}-{}",
+            std::process::id(),
+            std::thread::current().name().unwrap_or("unnamed")
+        ))
+    }
+
+    #[test]
+    fn detects_active_paritydb_reindex() {
+        let root = test_directory("reindex");
+        fs::create_dir_all(&root).unwrap();
+        fs::File::create(root.join("index_01_17")).unwrap();
+        assert!(!paritydb_has_stale_indexes(&root).unwrap());
+        fs::File::create(root.join("index_01_18")).unwrap();
+        assert!(paritydb_has_stale_indexes(&root).unwrap());
+        fs::File::create(root.join("index_02_16")).unwrap();
+        assert!(paritydb_has_stale_indexes(&root).unwrap());
+        fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn finds_nested_paritydb_database() {
+        let root = test_directory("find-db");
+        let full = root.join("chains/test/paritydb/full");
+        fs::create_dir_all(&full).unwrap();
+        fs::write(full.join("metadata"), b"metadata").unwrap();
+        assert_eq!(find_paritydb_full_path(&root).unwrap(), full);
+        fs::remove_dir_all(root).unwrap();
+    }
+}
